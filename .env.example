# -----------------------------------------------------------------------------
# Supabase Configuration (Required for Attendance & Analytics)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Simosan Attendance Signing & Device Policy
# -----------------------------------------------------------------------------
# REQUIRED: Active key ID used for signing QR codes (defaults to attendance-v1)
ATTENDANCE_QR_KEY_ID=attendance-v1

# REQUIRED: P-256 (prime256v1) EC private key in PKCS#8 PEM format (newlines escaped as \n)
ATTENDANCE_QR_PRIVATE_KEY=

# REQUIRED for production: JSON map of key IDs to P-256 public SPKI PEMs (must include the active key ID)
# Format: {"attendance-v1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
ATTENDANCE_QR_PUBLIC_KEYS_JSON={}

# REQUIRED: Cryptographically random high-entropy secret (at least 32 bytes, base64url recommended).
# WARNING: Stable infrastructure state. Changing this invalidates all student enrolled device digests.
ATTENDANCE_INSTALLATION_SECRET=

# OPTIONAL: Campus Geofence Boundary (leave all three empty to keep campus boundary disabled).
# If configured, all three must be valid numerical values. Do not invent arbitrary coordinates.
ATTENDANCE_CAMPUS_LATITUDE=
ATTENDANCE_CAMPUS_LONGITUDE=
ATTENDANCE_CAMPUS_RADIUS_METERS=

GEMINI_FREE_TIER_API_KEY=
GIT_SHA=
HEALTH_PORT=
LOG_LEVEL=
MIRROR_MAX_AGE_MS=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
VITE_REVENUECAT_IOS_KEY=
VITE_GOOGLE_TRANSLATE_API_KEY=
# Native ink is page-anchored by default. Set false only for emergency rollback.
VITE_PDF_NATIVE_INK_V2=true
VITE_PDF_STABLE_INTERACTION_ROUTING=true
ZAINCASH_API_KEY=
ZAINCASH_BASE_URL_PRODUCTION=
ZAINCASH_BASE_URL_UAT=
ZAINCASH_CLIENT_ID_PRODUCTION=
ZAINCASH_CLIENT_ID_UAT=
ZAINCASH_CLIENT_SECRET_PRODUCTION=
ZAINCASH_CLIENT_SECRET_UAT=
