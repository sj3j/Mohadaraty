node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# graphify knowledge graph (regenerable via `graphify update .`)
graphify-out/

# Source dumps / grep snapshots pasted into AI tools. These go stale immediately
# and pollute grep with duplicate hits of the real source.
map*.txt
*keys*.txt
check.txt

# Agent skills installed via `npx skills add` (re-installable; the install
# commands are recorded in .claude/skills/ATTRIBUTION.md)
.agents/

# Capacitor / Android build
android/local.properties
android/keystore.properties
*.jks
*.keystore
android/app/build/
android/build/
android/.gradle/
build-output/
# The synced web bundle. Regenerated by `cap sync` from dist/ on every build,
# and committing it would put a stale copy of the whole app in the repo.
android/app/src/main/assets/public/

# Capacitor / iOS build.
#
# ios/ is committed the way android/ is - the Xcode project, Info.plist and the
# Podfile are source. ios/.gitignore (written by `cap add ios`) already covers
# the generated parts: App/Pods, App/App/public, App/build, App/output and
# DerivedData. What it does NOT cover is signing material, which is what these
# lines are for. THIS REPO IS PUBLIC: a provisioning profile or a .p8 in a
# commit is a distribution credential anyone can take.
#
# Podfile.lock is deliberately NOT ignored - Codemagic needs it to build the
# same pods twice. Neither is GoogleService-Info.plist, which is client config
# and public by design, exactly like the committed android/app/google-services.json.
*.mobileprovision
*.p8
*.p12
*.cer
*.certSigningRequest
ios/App/export_options.plist
ios/App/App/capacitor.config.json

.vercel

# Personal Claude Code settings: .claude/settings.json here pins an absolute
# path to graphify.EXE on one machine, so committing it fires a broken hook for
# everyone else. Shared config belongs in .claude/settings.local.json.
.claude/settings.json

# Generated at build time by scripts/copyPdfjsAssets.mjs (regenerable)
public/pdfjs/

# The paywall preview build and the App Store review screenshots taken from it.
# Both are regenerable from scripts/paywallPreview/ (npm run build:paywall), and
# the PNGs are uploaded to App Store Connect rather than consumed by the app.
dist-paywall/
paywall-shots/

# Class rosters and the password sheets generated from them.
#
# THIS REPO IS PUBLIC. A roster file is a list of real students' full names, and
# scripts/generateRosterPasswords.ts emits their one-time passwords beside it.
# Neither may ever reach a commit.
/*.csv
/*.xlsx
*.import.csv
*.passwords.csv

# Ad-hoc QA scripts that hardcode a working password for a live account in the
# production project (claude.qa@mylecture.test). Useful locally, a credential
# leak in a public repo.
scripts/qaAccount.mjs
scripts/qaPassword.mjs
.firebase/

# Telegram mirror bot.
# The `!.env.example` negation near the top of this file is undone by the
# second `.env*` rule below it, and a negation without a path prefix would not
# reach a subdirectory anyway - so the example is re-allowed explicitly here.
bot/.env
!bot/.env.example
bot/bot.cjs
bot/node_modules

# Service-account credentials. THIS REPO IS PUBLIC.
# `serviceAccountKey*` is extension-less on purpose: makeServiceAccountBlob.ts
# writes the same key as both .json and .b64.txt, and a rule keyed to `.json`
# covers neither the base64 copy nor the next format someone adds.
# It is anchored to the "Key" prefix rather than written `*serviceAccount*`
# because that broader form would also ignore bot/src/serviceAccount.ts, which
# is source and must stay tracked.
serviceAccountKey*
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json

# JDK
jdk21/
jdk21.zip
