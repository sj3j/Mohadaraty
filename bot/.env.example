# Telegram mirror bot.
# Copy to bot/.env and fill in. bot/.env is gitignored and dockerignored.

# From @BotFather. This bot must be an ADMINISTRATOR of every stage channel,
# with post, edit and delete rights.
TELEGRAM_BOT_TOKEN=

# Service account. Same three variables server.ts and scripts/ authenticate
# with. The private key is one line with literal \n escapes, single-quoted.
FIREBASE_PROJECT_ID=mylectures-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# REQUIRED and explicit. Do not omit: the ${projectId}.appspot.com default that
# server.ts falls back to resolves to nothing for this project.
FIREBASE_STORAGE_BUCKET=mylectures-app.firebasestorage.app

# Optional
LOG_LEVEL=info
HEALTH_PORT=8081
# Announcements older than this are never mirrored outbound. The guard that
# stops a first boot from re-posting the back catalogue to five channels.
MIRROR_MAX_AGE_MS=86400000
# Shown in the admin UI so you can tell what is actually running.
GIT_SHA=
