# Telegram mirror bot.
# Copy to bot/.env and fill in. bot/.env is gitignored and dockerignored.

# From @BotFather. This bot must be an ADMINISTRATOR of every stage channel,
# with post, edit and delete rights.
TELEGRAM_BOT_TOKEN=

# Service account, in EITHER of two shapes.
#
# PREFERRED on a hosting panel: paste the whole service-account .json here,
# starting with { and ending with }. The private key inside it is a JSON
# string, so its \n escapes come back as real newlines via JSON.parse, by
# spec - nothing hand-rolled in the path for a text field to mangle.
# If this is set, the three variables below are ignored.
FIREBASE_SERVICE_ACCOUNT=

# Or the three separate variables, which is what server.ts and scripts/ use.
# Still supported, and repaired on the way in (bot/src/privateKey.ts handles
# double-escaped \\n, stored quotes and collapsed whitespace) - but this is the
# form that puts a PEM through a one-line text field and gets it back wrong.
FIREBASE_PROJECT_ID=mylectures-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# REQUIRED and explicit. Do not omit: the ${projectId}.appspot.com default that
# server.ts falls back to resolves to nothing for this project.
FIREBASE_STORAGE_BUCKET=mylectures-app.firebasestorage.app

# Optional
LOG_LEVEL=info
HEALTH_PORT=8081
# Announcements older than this are never mirrored outbound. The guard that
# stops a first boot from re-posting the back catalogue to five channels.
MIRROR_MAX_AGE_MS=86400000
# Shown in the admin UI so you can tell what is actually running.
GIT_SHA=
