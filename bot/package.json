{
  "name": "mylecture-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bidirectional mirror between five Telegram channels and the announcements feed.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node bot.cjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --sourcemap --outfile=bot.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx test/entities.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "22"
  }
}
