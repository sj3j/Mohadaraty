rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: lectures
// Document ID: {lectureId}
// Fields:
//   - title: string (required, 1-100 chars)
//   - category: string (required, enum: pharmacology, pharmacognosy, organic_chemistry, biochemistry, cosmetics)
//   - type: string (required, enum: theoretical, practical)
//   - description: string (optional, 0-500 chars)
//   - pdfUrl: string (required, valid URL)
//   - createdAt: timestamp (required)
//   - uploadedBy: string (required, UID)
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - name: string (required)
//   - email: string (required, email format)
//   - role: string (required, enum: admin, moderator, student)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // KEEP IN SYNC WITH shared/masterAdmins.ts. Rules cannot import, so the
    // addresses are repeated here; `npm run test:masters` fails if they drift.
    function isMasterAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null &&
          request.auth.token.email.lower() in [
            'almdrydyl335@gmail.com',
            'dra016go@gmail.com',
            'jempe.kn@gmail.com'
          ]) ||
        ('role' in request.auth.token && request.auth.token.role == 'master_admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master_admin')
      );
    }

    // Role recorded on the caller's allowed_admins entry, or '' when absent.
    // Docs created before assistants existed have no role field and default to 'admin'.
    function assistantRole() {
      return (request.auth.token.email != null &&
              exists(/databases/$(database)/documents/allowed_admins/$(request.auth.token.email.lower())))
        ? get(/databases/$(database)/documents/allowed_admins/$(request.auth.token.email.lower())).data.get('role', 'admin')
        : '';
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    // The stage this caller is enrolled in, or '' if unset. Server-owned: the
    // users rules below freeze stageId against self-edits.
    function userStage() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('stageId', '')
        : '';
    }

    // The stage this caller represents, or '' if unassigned.
    function myManagedStage() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('managedStageId', '')
        : '';
    }

    // A stage representative or the master admin. Deliberately EXCLUDES moderators:
    // merely appearing in allowed_admins is no longer sufficient.
    function isAdmin() {
      return isAuthenticated() && (
        isMasterAdmin() ||
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        userRole() == 'admin' ||
        assistantRole() == 'admin'
      );
    }

    // An assistant appointed by a representative. Content permissions only -
    // never the students collection or anything derived from it.
    function isModerator() {
      return isAuthenticated() && !isMasterAdmin() && (
        userRole() == 'moderator' || assistantRole() == 'moderator'
      );
    }

    // A cross-stage support account. Reaches every stage, capability by
    // capability, minus the master-only surfaces (adminLogs, the academic
    // calendar, Simosan billing) which are left gated on isMasterAdmin() alone.
    //
    // Deliberately says nothing about myManagedStage(): a support account
    // promoted from a representative KEEPS that field as a home stage, and
    // reading it as a scope here would pin them to the stage they used to
    // represent - see the ordering note in canWriteStage.
    //
    // Reads users/{uid} ONLY, unlike isAdmin()/isModerator() which also consult
    // allowed_admins. Two reasons, and the second is load-bearing:
    //
    //  1. There are no legacy support docs. The allowed_admins arm exists for
    //     roles that predate the role field; 'support' is new, and
    //     AdminManagement writes both documents, so users/{uid} is always set.
    //  2. ACCESS BUDGET. This is called from hasAccess(), isStaff() and
    //     canWriteStage(), which the announcements update rule evaluates on
    //     both of its branches. An allowed_admins arm here pushed that
    //     evaluation past the per-request document-access limit and denied an
    //     ordinary student's reaction - a rule with nothing to do with support.
    //     users/{uid} is already read by userRole() for isAdmin(), so reading
    //     only that costs nothing extra.
    function isSupport() {
      return isAuthenticated() && userRole() == 'support';
    }

    // What the caller was ticked for in إدارة المساعدين, off users/{uid}.
    // Absent means DENIED for a support account, matching canManage() in
    // src/lib/permissions.ts - never `!= false`, which is representative
    // semantics and would grant a support doc with no map everything.
    function supportCan(capability) {
      return isSupport() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('permissions', {}).get(capability, false) == true;
    }

    function isStaff() {
      return isAdmin() || isModerator() || isSupport();
    }

    // Content-write scope for a stage. Master admin writes anywhere; every other
    // staff member writes only the stage they are assigned to.
    //
    // STAGED ROLLOUT - the `myManagedStage() == ''` arm is a temporary grace.
    //
    // The intended rule is the strict one: assigned staff write only their own
    // stage, and unassigned staff write nothing. It is not safe to switch on yet
    // because no account has been given a managedStageId for the stage that
    // actually holds the content (every lecture, record and student is stage_3,
    // and the only assigned accounts point at stage_4). Turning it on today
    // would leave the hardcoded master admins above as the only accounts able
    // to upload anything.
    //
    // TO FINISH THE ROLLOUT: run scripts/assignStageRepresentatives.mjs, confirm
    // every representative has a managedStageId, then delete the
    // `myManagedStage() == '' ||` line below and redeploy. scripts/rules.test.mjs
    // already asserts the strict behaviour, so flip the expectation there too.
    //
    // The isSupport() arm sits INSIDE the isStaff() branch, ahead of the
    // managedStageId comparison, and both halves of that placement matter.
    //
    // Ahead of the comparison, because a support account promoted from a
    // representative still carries a managedStageId: reached second, the
    // comparison would match only their old stage and deny every other one, so
    // the role would look broken rather than misconfigured.
    //
    // Inside isStaff(), because as a separate top-level arm it is evaluated for
    // EVERY caller, and the extra document reads pushed the announcements
    // update rule past the per-request access limit - which denied an ordinary
    // student's reaction. Support is staff, so the meaning is unchanged and a
    // non-staff caller now short-circuits before reaching it.
    //
    // Role and stage only, no capability: that is the granularity these rules
    // have always had (a moderator ticked for chat alone still passes here, and
    // the per-capability gating lives in src/lib/permissions.ts). The capability
    // IS checked below for the surfaces that read the students whitelist or
    // change who holds a role, which is where it actually buys something.
    function canWriteStage(stageId) {
      return isMasterAdmin() || (
        isStaff() && (isSupport() || myManagedStage() == '' || myManagedStage() == stageId)
      );
    }

    // Students, unlike the content collections, are ADMIN-only: isStaff() would
    // let a moderator in, and src/lib/permissions.ts treats manageStudents as
    // admin-only precisely because this collection holds password hashes.
    //
    // An admin with no managedStageId manages nothing - the same stance
    // canWriteStage already takes, and the reason it has no unassigned
    // fallback. Reading every cohort's hashes while being able to write
    // nowhere would be the odd one out.
    // Carries the SAME temporary grace as canWriteStage, and is removed at the
    // same time. Production today lets any isAdmin() write any student; going
    // straight to the strict form would leave the master admins as the only
    // accounts able to manage the stage_3 roster, which is every student there is.
    //
    // Support reaches any stage's roster, but only when actually ticked for it -
    // this collection holds password hashes, so the capability is checked here
    // rather than left to the UI. It has to be tested BEFORE the isAdmin() arm:
    // a promoted representative still carries managedStageId, and reached
    // second that comparison pins them to their old stage.
    function canManageStudentsOn(stageId) {
      return isMasterAdmin() ||
        supportCan('manageStudents') || (
        isAdmin() && (myManagedStage() == '' || myManagedStage() == stageId)
      );
    }

    // Read scope for stage-owned content. Mirrors canWriteStage on the read side:
    // staff see the stage they manage, students see the stage they are enrolled in
    // (plus any subject they carry, via hasStageAccess).
    //
    // A null stageId means the document predates the multi-stage migration; those
    // stay readable by anyone with access, matching the lectures rule, rather than
    // vanishing from every screen at once.
    //
    // The isSupport() arm inside the isStaff() branch is what decides whether
    // the app looks EMPTY after a promotion: without it, the myManagedStage()
    // comparison hides every stage but the one they used to represent, and a
    // support account would read one stage's content while being able to write
    // all five. Placed inside isStaff() for the access-budget reason above.
    function canReadStage(stageId, subjectId) {
      return hasAccess() && (
        stageId == null || stageId == '' ||
        isMasterAdmin() ||
        // Assigned staff, representative or moderator. Not isRepresentativeFor():
        // that excludes moderators, and a moderator's own stageId is often not
        // the stage they were appointed to moderate.
        (isStaff() && (isSupport() || myManagedStage() == stageId)) ||
        hasStageAccess(stageId, subjectId)
      );
    }

    function isValidLecture(data) {
      return data.keys().hasAll(['title', 'category', 'type', 'pdfUrl', 'createdAt', 'uploadedBy']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.category in ['pharmacology', 'pharmacognosy', 'organic_chemistry', 'biochemistry', 'cosmetics'] &&
             data.type in ['theoretical', 'practical'] &&
             data.pdfUrl is string && data.pdfUrl.matches(".*") &&
             data.createdAt is timestamp &&
             data.uploadedBy == request.auth.uid &&
             (!('number' in data) || data.number == null || (data.number is number && data.number > 0)) &&
             (!('isWeekly' in data) || data.isWeekly is bool) &&
             (!('version' in data) || data.version in ['original', 'translated']);
    }

    function isValidUser(data) {
      return (!('name' in data) || data.name is string) &&
             (!('email' in data) || data.email is string) &&
             // 'support' MUST be listed here. isValidUser gates the whole
             // self-edit branch below, so leaving it out does not merely block
             // appointing a support account - it silently refuses every write
             // that account makes to its OWN user doc afterwards: notification
             // toggles, leaderboard privacy, saving a profile edit.
             (!('role' in data) || data.role in ['admin', 'moderator', 'support', 'student', 'master_admin']) &&
             (!('originalName' in data) || data.originalName is string) &&
             (!('photoUrl' in data) || data.photoUrl == null || data.photoUrl is string) &&
             (!('completedWeeklyTasks' in data) || data.completedWeeklyTasks is list) &&
             (!('favorites' in data) || data.favorites is list) &&
             (!('studied' in data) || data.studied is list) &&
             (!('streakCount' in data) || data.streakCount is number) &&
             (!('longestStreak' in data) || data.longestStreak is number) &&
             (!('bestStreakAllTime' in data) || data.bestStreakAllTime is number) &&
             (!('freezeTokens' in data) || data.freezeTokens is number) &&
             // Both of these are nulled, not removed, by the season reset
             // (shared/seasonReset.ts sets lastActiveDate: null for EVERY user).
             // Without the null arm `null is string` is false, isValidUser fails,
             // and the whole self-edit branch below is refused - which silently
             // blocked notification toggles, the leaderboard privacy switches and
             // saving a profile edit for every user who had been through a reset.
             // photoUrl and subscriptionEnd already read this way.
             (!('lastActiveDate' in data) || data.lastActiveDate == null || data.lastActiveDate is string) &&
             (!('lastActiveAt' in data) || data.lastActiveAt == null || data.lastActiveAt is timestamp) &&
             (!('hasPendingStreakReset' in data) || data.hasPendingStreakReset is bool) &&
             (!('examCode' in data) || data.examCode is string) &&
             (!('group' in data) || data.group is string) &&
             // Set by the student when they tap the exam-code card's
             // "ask me later". Self-writable on purpose; the exam code itself
             // is frozen below and only /api/me/exam-code can set it.
             (!('examCodePromptSnoozedUntil' in data) || data.examCodePromptSnoozedUntil is string) &&
             (!('blockedUsers' in data) || data.blockedUsers is list) &&
             (!('permissions' in data) || data.permissions is map) &&
             (!('isSubscribed' in data) || data.isSubscribed is bool) &&
             (!('subscriptionEnd' in data) || data.subscriptionEnd == null || data.subscriptionEnd is timestamp) &&
             (!('subscriptionPlan' in data) || data.subscriptionPlan == null || data.subscriptionPlan in ['monthly', 'seasonal', 'semi_annual']);
    }

    function isWhitelisted() {
      return isAuthenticated() && (
        (request.auth.token.email != null && exists(/databases/$(database)/documents/students/$(request.auth.token.email.lower()))) ||
        exists(/databases/$(database)/documents/students/$(request.auth.uid))
      );
    }

    // isSupport() is here for the same reason isAdmin() is: a support account
    // appointed from outside the roster has no students/{email} doc, and
    // without this canReadStage() would refuse them every stage including the
    // one they came from.
    function hasAccess() {
      return isAdmin() || isWhitelisted() || isSupport();
    }

    // Gates `subjects` and stages/{id}.groupConfig. Support is granted the same
    // on ANY stage, but only when ticked for manageGroups - inheriting this by
    // accident through isStaff() is what the explicit arm avoids.
    function isRepresentativeFor(stageId) {
      return (isAdmin() && myManagedStage() == stageId) || supportCan('manageGroups');
    }

    function hasStageAccess(stageId, subjectId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let user = userDoc != null ? userDoc.data : {};
      return user.get('stageId', '') == stageId ||
             (subjectId != '' && subjectId in user.get('tahmeelSubjects', []));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // The academic calendar decides whether the competition is running for the
    // whole university, so it is master-admin only. Firestore grants access if
    // ANY matching rule allows it, so this cannot be a narrower rule added
    // alongside a permissive wildcard - the condition has to live here.
    match /app_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if docId == 'academicCalendar' ? isMasterAdmin() : isAdmin();
    }

    // Back-office configuration that is NOT safe to show every student.
    //
    // Separate from app_settings for one concrete reason: that block reads
    // `allow read: if isAuthenticated()`, and admin_config/telegram enumerates
    // the private Telegram channel ids of all five stages. A private channel's
    // id is the one piece of data that makes it findable, so 400+ student
    // accounts must not be able to list it.
    //
    //   telegram        - the channel map, edited by the master admin in-app.
    //   telegram_status - written by the mirror bot (Admin SDK, bypasses these
    //                     rules) and read by the admin UI to show health. No
    //                     client may write it, or "the bot is healthy" would be
    //                     forgeable.
    //   telegram_state  - the bot's getUpdates offset and its single-instance
    //                     lease. No client business at all, in either direction.
    match /admin_config/{docId} {
      allow read: if isMasterAdmin() && docId in ['telegram', 'telegram_status'];
      allow write: if isMasterAdmin() && docId == 'telegram';
    }

    // User-generated content reporting (Apple 1.2 / Play UGC policy).
    //
    // Anyone signed in may file a report, and only about themselves as
    // reporter, so a report cannot be forged in someone else's name. Nobody but
    // a moderator can read them - a report names the reporter, and letting the
    // reported party read it would make reporting unsafe. Immutable once filed;
    // moderators triage via the Admin SDK.
    // Self-service signup queue.
    //
    // NO client write at all - /api/signup/request owns it, because the row
    // holds a password hash and the request must be validated (real stage, valid
    // subgroup, not already a student) before it exists. Readable only by staff:
    // a request carries an applicant's email and hash.
    match /signup_requests/{email} {
      allow read: if isAdmin() || isModerator();
      allow write: if false;
    }

    match /content_reports/{reportId} {
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.messageId is string
                    && request.resource.data.reason is string;
      // Moderators are the ones who actually watch the chat, so they must be
      // able to triage - isAdmin() alone deliberately excludes them.
      allow read: if isAdmin() || isModerator();
      allow update, delete: if isMasterAdmin();
    }

    match /semesterArchives/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Archived streak season results shown on the student's own profile.
    // Written only by the Admin SDK during a season reset, which bypasses rules.
    //
    // This was `isAdmin()`, which let any admin CLIENT rewrite a finished season.
    // One card was overwritten that way three weeks after its archive run
    // (finalStreak 15 -> 2) while every peer card still matched semesterArchives,
    // and there is no legitimate client writer. Matches mcqHistory and
    // yearHistory below, which were already write:false.
    match /users/{userId}/streakHistory/{document=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Archived MCQ season results shown on the student's own profile.
    // Written only by the Admin SDK during a season reset.
    match /users/{userId}/mcqHistory/{document=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // The year card that survives the year-end wipe: score, MCQs solved, bank
    // questions answered. All the data behind those numbers is deleted, so this
    // is the student's only record of the year - client writes are refused so it
    // cannot be forged after the evidence is gone.
    match /users/{userId}/yearHistory/{document=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /allowed_admins/{email} {
      allow read: if isAuthenticated();
      // A representative may only create/edit MODERATORS, and only on the stage
      // they themselves manage. Everything else is master-admin territory.
      //
      // Support, when ticked for manageAdmins, may seat representatives and
      // moderators on ANY stage - but never another support account and never a
      // master_admin. That ceiling is the escalation guard: the three
      // master-only surfaces are unreachable to support directly, and a support
      // account able to mint a second one could hand them out by proxy. The UI
      // half is appointableRoles() in src/lib/permissions.ts; this is the half
      // that actually holds.
      allow create, update: if isMasterAdmin() || (
        supportCan('manageAdmins') &&
        request.resource.data.get('role', '') in ['admin', 'moderator']
      ) || (
        isAdmin() &&
        request.resource.data.get('role', '') == 'moderator' &&
        request.resource.data.get('managedStageId', '') == myManagedStage() &&
        myManagedStage() != ''
      );
      allow delete: if isMasterAdmin() || (
        supportCan('manageAdmins') &&
        resource.data.get('role', '') in ['admin', 'moderator']
      ) || (
        isAdmin() &&
        resource.data.get('role', '') == 'moderator' &&
        resource.data.get('managedStageId', '') == myManagedStage() &&
        myManagedStage() != ''
      );
    }
    
    // The pre-registration whitelist, and the credential store: it holds every
    // student's password hash, so `isAdmin()` alone was the widest remaining
    // grant in this file. Any representative could read every other stage's
    // roster and overwrite or delete its students - which, now that each
    // representative bulk-imports their own list, is one stale stage picker
    // away from rewriting a live cohort's passwords.
    //
    // Scoped with the same create/update-and-target pair used for lectures,
    // records, homeworks and announcements below.
    //
    // canReadStage() is deliberately not reused: it admits moderators, and it
    // returns true when stageId is '', which would leave any student document
    // missing a stage readable by every signed-in user.
    match /students/{email} {
      allow get, list: if (isAuthenticated() && (request.auth.uid == email
            || (request.auth.token.email != null && request.auth.token.email.lower() == email)))
        || canManageStudentsOn(resource.data.get('stageId', ''));

      allow create: if canManageStudentsOn(request.resource.data.get('stageId', ''));

      // `request.resource == null`, not `request.resource.data == null`: on a
      // delete there is no incoming resource at all, so reaching for .data
      // raises a null-value error and denies the write outright.
      allow update, delete: if canManageStudentsOn(resource.data.get('stageId', '')) &&
        (request.resource == null
         || canManageStudentsOn(request.resource.data.get('stageId', '')));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role == 'student' || 
                     (request.resource.data.role == assistantRole() && assistantRole() != '') ||
                     (request.resource.data.role in ['admin'] && isMasterAdmin()));
      allow update: if isMasterAdmin() || 
                      (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['examCode', 'name', 'originalName'])) || 
                      // Appointing a moderator writes these three fields onto their
                      // user doc. Restricted to role == 'moderator' so a representative
                      // cannot mint another admin.
                      (isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'managedStageId', 'permissions']) &&
                       request.resource.data.get('role', '') == 'moderator' &&
                       request.resource.data.get('managedStageId', '') == myManagedStage()) ||
                      // The support half of the same appointment write. No
                      // managedStageId constraint - support seats staff on any
                      // stage, and requiring it to match their own home stage
                      // would reintroduce exactly the pin the role removes.
                      // 'student' is in the list because that is what demotion
                      // writes (revokeStaffRole); without it support could seat
                      // staff and never unseat them. 'support' and
                      // 'master_admin' are absent on purpose - see
                      // allowed_admins above.
                      (supportCan('manageAdmins') &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'managedStageId', 'permissions']) &&
                       request.resource.data.get('role', '') in ['admin', 'moderator', 'student']) ||
                      (isOwner(userId) && isValidUser(request.resource.data) && (
                        (!('role' in request.resource.data) || request.resource.data.role == resource.data.get('role', 'student')) ||
                        (request.resource.data.role == assistantRole() && assistantRole() != '')
                      ) && (!('originalName' in request.resource.data) || request.resource.data.originalName == resource.data.get('originalName', ''))
                        && (!('examCode' in request.resource.data) || request.resource.data.examCode == resource.data.get('examCode', ''))
                        && request.resource.data.get('streakCount', 0) == resource.data.get('streakCount', 0)
                        && request.resource.data.get('freezeTokens', 1) == resource.data.get('freezeTokens', 1)
                        && request.resource.data.get('longestStreak', 0) == resource.data.get('longestStreak', 0)
                        && request.resource.data.get('bestStreakAllTime', 0) == resource.data.get('bestStreakAllTime', 0)
                        && request.resource.data.get('lastActiveDate', '') == resource.data.get('lastActiveDate', '')
                        // Stage and progression are server-owned. The generic
                        // self-edit branch never froze these, so a student could
                        // simply set their own stageId through it.
                        && request.resource.data.get('stageId', '') == resource.data.get('stageId', '')
                        && request.resource.data.get('graduated', false) == resource.data.get('graduated', false)
                        && request.resource.data.get('progressionState', '') == resource.data.get('progressionState', '')
                        && request.resource.data.get('progressionYear', '') == resource.data.get('progressionYear', '')
                        && request.resource.data.get('tahmeelSubjects', []) == resource.data.get('tahmeelSubjects', [])
                        // Subscription state is bought, not self-declared. Only the Admin
                        // SDK writes these - ZainCash settlement and the admin grant route -
                        // and it bypasses rules. Without this freeze the generic self-edit
                        // branch let any student set isSubscribed from the browser console
                        // and unlock every paid course, since App.tsx gates access on it.
                        && request.resource.data.get('isSubscribed', false) == resource.data.get('isSubscribed', false)
                        && request.resource.data.get('subscriptionEnd', null) == resource.data.get('subscriptionEnd', null)
                        && request.resource.data.get('subscriptionPlan', null) == resource.data.get('subscriptionPlan', null)
                        // Points at the ZainCash payment currently open at the
                        // gateway. /api/zaincash/init refuses to start a second
                        // one while it is set, so a client that could clear it
                        // could mint duplicate transactions at will.
                        && request.resource.data.get('pendingZainCashRef', '') == resource.data.get('pendingZainCashRef', ''));
                      // Progression is recorded by /api/progression/submit with the
                      // Admin SDK, which also has to write students/{email}.stageId -
                      // a student cannot, and syncUserStage would otherwise revert the
                      // promotion at their next login. So there is deliberately NO
                      // self-write path for stageId here.
    }

    match /streak_history/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if false; // Only Cloud Functions / Admin SDK
    }

    match /streak_recoveries/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Only via API
    }

    // The doc id IS the uid, but ownership is checked against the stored field to
    // match streak_history above. HomeScreen reads this to render the student's
    // own "about to lose your streak" banner; while it was admin-only that read
    // was permission-denied for every student and the banner never appeared.
    match /pending_streak_resets/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if false; // Only via API
    }

    match /degrees/{studentId}/exams/{examId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == studentId);
      allow write: if isAdmin();
    }

    match /degreeBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    match /stages/{stageId} {
      allow read: if isAuthenticated();
      allow create, delete: if isMasterAdmin();
      // A representative configures groups/subgroups for their own stage only,
      // and may not touch any other field on the stage document.
      allow update: if isMasterAdmin() || (
        isRepresentativeFor(stageId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupConfig'])
      );
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create: if isMasterAdmin() || (isAdmin() && isRepresentativeFor(request.resource.data.stageId));
      allow update, delete: if isMasterAdmin() || (isAdmin() && isRepresentativeFor(resource.data.stageId));
    }

    match /lectures/{lectureId} {
      // For backwards compatibility and migration, we allow access if stageId is missing.
      allow read: if hasAccess() && (
        !('stageId' in resource.data) || resource.data.stageId == null ||
        isMasterAdmin() || isRepresentativeFor(resource.data.stageId) ||
        hasStageAccess(resource.data.stageId, resource.data.get('subjectId', ''))
      );
      
      allow create: if canWriteStage(request.resource.data.get('stageId', ''));

      // `request.resource == null`, not `request.resource.data == null`: a
      // delete carries no incoming resource, so reaching for .data raises a
      // null-value error and denied every delete a representative attempted.
      allow update, delete: if canWriteStage(resource.data.get('stageId', '')) &&
        (request.resource == null || canWriteStage(request.resource.data.get('stageId', '')));
    }
    
    match /chat_presence/{userId} {
      allow read: if hasAccess();
      allow write: if isOwner(userId);
    }

    match /chat_settings/{documentId} {
      allow read: if hasAccess();
      allow write: if isAdmin();
    }

    match /chat_messages/{messageId} {
      // Group messages carry stageId and are read per stage. Direct messages and
      // anything predating the migration have none, and stay readable as before -
      // narrowing those is a separate change to ChatScreen's own queries.
      allow read: if canReadStage(resource.data.get('stageId', null), '');
      // A stamped message must land in the sender's own stage. Unstamped ones
      // (DMs) keep the previous behaviour, or representatives lose direct chat.
      allow create: if isAdmin() && (
        request.resource.data.get('stageId', null) == null ||
        canWriteStage(request.resource.data.stageId)
      );
      allow update: if isAdmin() || (
        hasAccess() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'viewers']) &&
        request.auth.token.email != null
      );
      allow delete: if isAdmin() || 
                    (isAuthenticated() && (
                      resource.data.get('senderId', '') == request.auth.uid ||
                      (request.auth.token.email != null && resource.data.get('senderEmail', '') == request.auth.token.email)
                    ));
      
      match /private/{docId} {
        allow read: if isMasterAdmin();
        allow write: if isAuthenticated();
      }
    }

    match /chat_typing/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /inbox_sessions/{sessionId} {
      allow read, write: if hasAccess();
      allow create, update: if isAuthenticated() && request.auth.token.email != null && request.resource.data.studentEmail == request.auth.token.email;
      allow read: if isAuthenticated() && request.auth.token.email != null && resource.data.studentEmail == request.auth.token.email;
    }

    match /private_chats/{chatId}/{document=**} {
      allow read, write: if hasAccess();
      allow read, write: if isAuthenticated() && request.auth.token.email != null && chatId.matches('.*' + request.auth.token.email + '.*');
    }

    // records / announcements / homeworks all carry stageId and are filtered by
    // it in the client. Until now the rules did not check it, so the isolation
    // was a UI convenience: any student could hand-craft a query for another
    // stage's content, and any staff member could write into another stage.
    // These three now mirror the lectures rules above.

    match /records/{recordId} {
      allow read: if canReadStage(resource.data.get('stageId', null), resource.data.get('subjectId', ''));
      allow create: if canWriteStage(request.resource.data.get('stageId', ''));
      // `request.resource == null`, not `request.resource.data == null`: a
      // delete carries no incoming resource, so reaching for .data raises a
      // null-value error and denied every delete a representative attempted.
      allow update, delete: if canWriteStage(resource.data.get('stageId', '')) &&
        (request.resource == null || canWriteStage(request.resource.data.get('stageId', '')));
    }

    match /announcements/{postId} {
      allow read: if canReadStage(resource.data.get('stageId', null), '');
      allow create: if canWriteStage(request.resource.data.get('stageId', ''));
      allow delete: if canWriteStage(resource.data.get('stageId', ''));
      // A reader may only ever touch the reactions map, and only on a post they
      // are allowed to read in the first place.
      allow update: if (
        canWriteStage(resource.data.get('stageId', '')) &&
        (request.resource.data == null || canWriteStage(request.resource.data.get('stageId', '')))
      ) || (
        canReadStage(resource.data.get('stageId', null), '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );

      // Poll ballots.
      //
      // ANONYMOUS: a ballot is readable by the student who cast it and by staff,
      // never by another student. That boundary is the whole reason votes are a
      // subcollection rather than a `votes` map on the post - a map would be
      // readable by everyone who can read the post, so "anonymous poll" would
      // have been a label rather than a property.
      //
      // The aggregate stays public: `poll.counts` lives on the parent document
      // and is written ONLY by the tallyPollVotes Cloud Function through the
      // Admin SDK, which is why the reader escape hatch above still needs to
      // permit nothing but `reactions`. A student cannot inflate a tally,
      // because a student cannot write the field that holds it.
      match /votes/{voterId} {
        allow read: if isStaff() || (isAuthenticated() && request.auth.uid == voterId);
        allow write: if isAuthenticated()
          && request.auth.uid == voterId
          && canReadStage(get(/databases/$(database)/documents/announcements/$(postId)).data.get('stageId', null), '');
      }
    }

    match /homeworks/{homeworkId} {
      allow read: if canReadStage(resource.data.get('stageId', null), '');
      allow create: if canWriteStage(request.resource.data.get('stageId', ''));
      // `request.resource == null`, not `request.resource.data == null`: a
      // delete carries no incoming resource, so reaching for .data raises a
      // null-value error and denied every delete a representative attempted.
      allow update, delete: if canWriteStage(resource.data.get('stageId', '')) &&
        (request.resource == null || canWriteStage(request.resource.data.get('stageId', '')));
    }
    
    match /mcqs/{lectureId} {
      allow read: if hasAccess();

      // create was `hasAccess()` because generation ran in the STUDENT's browser
      // and the student's own client wrote the result. Generation is server-side
      // now, so nothing legitimate creates this document from a client - and the
      // old rule let any student with access forge a whole lecture's answer key.
      allow create: if false;

      // Updates stay client-writable for staff only: an admin editing a single
      // question with AI writes the amended set back through
      // updateLectureMCQSet. Students never write here.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // Student "please generate questions for this lecture" requests. Written by
    // the API, which also notifies staff; readable by staff so the queue can be
    // worked through. A client-writable version would be a spam channel into
    // every admin's inbox.
    match /mcqRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /userMCQAnswers/{userId}/lectures/{document=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

    match /userMCQStats/{userId} {
      allow read: if hasAccess();
      // A user maintains their own stats doc - mcqAnswerService writes it on every
      // submission - but stageId is not theirs to choose. The rule previously
      // accepted any field, so a student could write {stageId: 'stage_5'} from the
      // console and appear on another stage's leaderboard. Pin it to the stage on
      // their own user doc, which only the Admin SDK can change.
      //
      // The scores themselves stay client-written: they are computed in
      // mcqAnswerService from the answer history, and constraining them here
      // would mean reimplementing that arithmetic in rules. Forging your own
      // score remains possible; forging your stage no longer is.
      allow write: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.get('stageId', userStage()) == userStage()
      );
    }

    // --- Simosan (AI lecture tutor) ------------------------------------
    //
    // Every one of these is server-written. The daily energy allowance and the
    // monthly ceiling only mean something because a student cannot reach the
    // documents that record them - the existing client-side Gemini path in
    // mcqGenerationService has no such guarantee, which is exactly the problem
    // Simosan was built server-side to avoid.

    // Chat threads. Readable by their owner so the drawer can render history
    // and an admin can investigate a report; written only by the API, so a
    // student cannot forge an assistant turn or trim history to underpay.
    match /aiChats/{userId}/{document=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Energy ledger. Readable by its owner for the energy bar; never writable
    // from a client - this document IS the limit.
    //
    // Ownership is read from the stored `uid` field, NOT parsed out of the
    // document id. The id is `{uid}_{YYYY-MM-DD}` and a uid may itself contain
    // an underscore, so splitting on "_" can yield a prefix rather than the
    // real uid - which denies a student their own row and, worse, would match
    // whoever happens to own that prefix.
    match /aiUsage/{usageId} {
      allow read: if isAuthenticated() &&
                     (isAdmin() ||
                      (resource != null && resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    // Gemini Files API URI cache. Server-only in both directions: a leaked file
    // URI is a readable copy of the lecture that bypasses hasAccess().
    match /aiFiles/{lectureId} {
      allow read, write: if false;
    }

    match /systemNotifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid; // Allow user to delete their own notifications if needed
    }

    match /adminAlerts/{alertId} {
      allow create: if hasAccess(); // E.g., when they trigger an incomplete Generation that requires admin review
      allow read, update, delete: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow create: if hasAccess();
      allow read, update, delete: if isAdmin();
    }

    match /antiCheatLogs/{logId} {
      allow create: if hasAccess();
      allow read, update, delete: if isAdmin();
    }
    
    match /questionBank/{questionId} {
      allow read: if hasAccess();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        hasAccess() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFlagged', 'flaggedReason', 'flaggedBy', 'flaggedAt']) &&
        request.resource.data.isFlagged == true
      );
    }

    match /userBankAnswers/{userId}/questions/{questionId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId) || isAdmin();
    }
    
    match /adminLogs/{logId} {
      // Support WRITES here and cannot read: its actions - seating a
      // representative, editing another stage's roster - are exactly what the
      // master admin needs the trail for. Without create, logAdminAction()
      // throws mid-appointment in AdminManagement, after the role write has
      // already landed.
      allow create: if isAdmin() || isSupport();
      allow read: if isMasterAdmin();
      allow update, delete: if false;
    }
    
    // A student's request to have their account deleted, awaiting review.
    //
    // Create is the ONLY client write: the approval purges an Auth user and a
    // dozen documents, which no client credential can do, so the review runs
    // through the Admin SDK and this collection is read-only to everyone after
    // the request lands. Cancelling goes through the API too, so a request
    // cannot be quietly withdrawn by editing the row.
    match /deletion_requests/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.uid == userId;
      allow update, delete: if false;
    }

    match /fcm_tokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // Subscriptions
    // ===============================================================
    match /subscriptions/{subId} {
      // Users can read their own subscriptions, admins can read all
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Users can create pending subscriptions for themselves (SuperKey flow)
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.userId == request.auth.uid && 
        request.resource.data.status == 'pending'
      );
      // Only admins (and Admin SDK via webhooks) can update subscriptions
      allow update: if isAdmin();
      // No deletes
      allow delete: if false;
    }
  }
}