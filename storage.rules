rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    // Mirrors isMasterAdmin() in firestore.rules.
    //
    // This used to be missing, and its absence was a live bug rather than a
    // theoretical gap: isStaff() below tests `role in ['admin','moderator']`,
    // and a master admin's user document carries role 'master_admin'. The one
    // account with authority over every stage was therefore the one account
    // that could not attach a file to an announcement.
    // KEEP IN SYNC WITH shared/masterAdmins.ts and firestore.rules.
    function isMasterAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null &&
          request.auth.token.email.lower() in [
            'almdrydyl335@gmail.com',
            'dra016go@gmail.com',
            'jempe.kn@gmail.com'
          ]) ||
        ('role' in request.auth.token && request.auth.token.role == 'master_admin') ||
        (hasUserDoc() && userDoc().role == 'master_admin')
      );
    }

    function isStaff() {
      return isMasterAdmin() || (hasUserDoc() && userDoc().role in ['admin', 'moderator']);
    }

    // Content-write scope for a stage, mirroring canWriteStage() in
    // firestore.rules - including its staged-rollout grace for staff who have
    // no managedStageId yet. Keep the two in step: when that grace is removed
    // from firestore.rules, remove it here in the same change.
    function canWriteStage(stageId) {
      return isMasterAdmin() || (
        isStaff() && (
          !('managedStageId' in userDoc()) ||
          userDoc().managedStageId == '' ||
          userDoc().managedStageId == stageId
        )
      );
    }

    // Profile pictures: Any user can upload their own
    match /profiles/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && fileName.matches(request.auth.uid + ".*");
    }

    // Lectures: Only staff can upload
    match /lectures/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Announcement attachments are stage-scoped: the composer writes to
    // announcements/{stageId}/{fileName}, so a representative for one stage
    // cannot drop files into another's prefix. Previously this path carried no
    // stage check at all, which made it the one hole left in stage isolation
    // after firestore.rules closed the document side.
    match /announcements/{stageId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if canWriteStage(stageId);
    }

    // Flat legacy prefix, kept readable for files attached before the composer
    // began scoping uploads by stage. Deliberately not writable: new uploads
    // must go through the stage-scoped path above.
    match /announcements/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Weekly Tasks: Only staff can upload
    match /weekly_tasks/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Chat Attachments: Authenticated users can upload their own files
    match /chat_attachments/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && fileName.matches(request.auth.uid + ".*");
    }

    // Proof of a manual Super Qi / Qi Card transfer, uploaded by the student
    // who made it. Same uid-prefix contract as the two paths above, which is
    // what receiptStoragePath() in src/lib/paymentContact.ts builds - the
    // default fallback below grants write to STAFF only, so without this rule a
    // student attaching a receipt gets a 403 and the form cannot be completed.
    //
    // Unlike those paths this one caps size and demands an image: it is the
    // only student-writable prefix added since the app started taking money,
    // and a 5MB image ceiling is what keeps an accidental video out of the
    // bucket. A HEIC from an iPhone gallery can arrive with no contentType at
    // all, so the check admits an absent one rather than rejecting the upload.
    //
    // Reads are NOT narrowed here, and cannot be: the fallback below already
    // allows any authenticated read, and Storage grants access if ANY matching
    // rule allows it, so a stricter rule alongside a permissive wildcard buys
    // nothing. What actually keeps a receipt private is the download token in
    // the getDownloadURL() link - the object name itself is unguessable anyway
    // (uid + timestamp + salt).
    match /payment_receipts/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && fileName.matches(request.auth.uid + ".*")
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType == null ||
                       request.resource.contentType.matches('image/.*'));
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
  }
}
